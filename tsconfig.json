{
  "compilerOptions": {
    "lib": [
      "es2021"
    ],
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2024",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./build",
//    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
